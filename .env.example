# ==========================================
# SocialHub AI — Environment Configuration
# ==========================================
# WARNING: NEVER commit real API keys, secrets, or tokens to git or frontend bundles.
# Copy this file to .env.local for local development.

# ------------------------------------------
# 1. Base Application URL
# ------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------
# 2. Supabase Cloud (PostgreSQL Database & Auth)
# ------------------------------------------
# Get these from your Supabase Project Settings -> API: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Server-side ONLY (never prefix with NEXT_PUBLIC_):
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------
# 3. AI Providers (Server-Side Only)
# ------------------------------------------
# Google Gemini (Recommended - Free Tier available at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIzaSy...

# Groq Cloud (Ultra-fast LPU inference at https://console.groq.com/keys)
GROQ_API_KEY=gsk_...

# OpenAI (Enterprise models at https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# ------------------------------------------
# 4. Job Search API (Adzuna Developer Portal)
# ------------------------------------------
# Sign up at https://developer.adzuna.com for free API access (250 calls/day)
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# ------------------------------------------
# 5. Social Media OAuth 2.0 Credentials (Server-Side Only)
# ------------------------------------------
# LinkedIn Developer Portal (https://www.linkedin.com/developers)
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# Meta for Developers (Facebook & Instagram Graph API)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# X (Twitter) Developer Portal
X_CLIENT_ID=your_x_client_id
X_CLIENT_SECRET=your_x_client_secret

# YouTube / Google Cloud Console (OAuth 2.0 Client)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ------------------------------------------
# 6. Background Task Scheduler (Upstash QStash)
# ------------------------------------------
# Free tier: 500 delayed messages/day at https://console.upstash.com/qstash
QSTASH_TOKEN=ey...
QSTASH_CURRENT_SIGNING_KEY=sig_...
QSTASH_NEXT_SIGNING_KEY=sig_...

# Secret token to protect internal cron dispatch webhook:
CRON_SECRET=generate_a_random_32_character_secret_here
